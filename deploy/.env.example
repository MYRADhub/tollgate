# Public hostname. With no domain, use <server-ip>.sslip.io and Caddy gets a TLS certificate for it.
DOMAIN=203.0.113.10.sslip.io

# Vultr Managed PostgreSQL (connection string from the Vultr console, sslmode=require)
TOLLGATE_DATABASE_URL=postgresql+psycopg://vultradmin:PASSWORD@HOST:16751/defaultdb?sslmode=require

# Vultr Serverless Inference
TOLLGATE_INFERENCE_API_KEY=
TOLLGATE_MODEL_VISION=qwen3.8-27b
TOLLGATE_MODEL_REASONING=deepseek-v4.1-flash-1017
TOLLGATE_MODEL_SAFETY=nemotron-3.5-content-safety

# Vultr Object Storage (S3-compatible)
TOLLGATE_S3_ENDPOINT=https://ewr1.vultrobjects.com
TOLLGATE_S3_BUCKET=tollgate-invoices
TOLLGATE_S3_ACCESS_KEY=
TOLLGATE_S3_SECRET_KEY=

# Gmail AP mailbox (2-step verification on, then an app password)
TOLLGATE_MAIL_ENABLED=true
TOLLGATE_GMAIL_ADDRESS=
TOLLGATE_GMAIL_APP_PASSWORD=

TOLLGATE_CORS_ORIGINS=https://203.0.113.10.sslip.io
TOLLGATE_DEMO_MODE=true
